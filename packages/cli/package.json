{
  "name": "confer-cli",
  "version": "0.3.1",
  "description": "Start a self-hosted Confer instance with one command",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyhmrright/Confer.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hyhmrright/Confer#readme",
  "keywords": [
    "confer",
    "a2a",
    "agent",
    "mcp",
    "self-hosted"
  ],
  "type": "module",
  "bin": {
    "confer": "./dist/confer.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --outfile=./dist/confer.mjs && cp ../../docker-compose.ghcr.yml ./dist/docker-compose.ghcr.yml",
    "prepack": "bun run build",
    "test": "bun test"
  }
}
