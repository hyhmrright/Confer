{
  "name": "@confer/gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:db:setup": "bun run scripts/setup-test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@confer/agent-runtime": "workspace:*",
    "@confer/identity": "workspace:*",
    "@confer/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "minio": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
